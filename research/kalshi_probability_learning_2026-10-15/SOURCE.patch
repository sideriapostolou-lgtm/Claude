+
+@pytest.mark.parametrize("source_at,expected", [(1297, 1), (1300, 1), (1296.999, 0), (1300.001, 0)])
+def test_batch_source_age_independent_of_fresh_bitcoin(source_at: float, expected: int) -> None:
