# nightcrawler configuration. Copy to .env for local runs (NEVER commit .env),
# or set these as Railway service variables. Blank = default.
# Units: *_PCT knobs under 'Bankroll & risk' and 'Strategy' are FRACTIONS (0.20 = 20%);
# MAX_PRICE_IMPACT_PCT, MAX_SLIPPAGE_PCT, COCOON_*_PCT and RADAR_*_PCT are PERCENT (3.0 = 3%).
# Secrets (API keys, wallet secret, dashboard token) must stay empty in this file.
#
# Railway: attach a volume at /data and set DATA_DIR=/data (the image's default),
# plus RAILWAY_RUN_UID=0 - Railway mounts volumes as root and the image runs as a
# non-root user, so without it the ledger cannot be written. Railway sets PORT itself.
# Set a long random DASHBOARD_TOKEN before exposing the dashboard on a public URL.


# ===== Mode & safety =========================================================

# paper (default, simulated fills from live quotes) or live (real money) [text; one of: paper |
# live]
TRADING_MODE=paper
# Must equal I_ACCEPT_REAL_MONEY_RISK for TRADING_MODE=live [text]
LIVE_CONFIRM=
# Where the SQLite ledger, KILL file and datasets live (Railway: /data) [path]
DATA_DIR=data
# Logging level [text; one of: DEBUG | INFO | WARNING | ERROR]
LOG_LEVEL=INFO
# off | stop (no new entries) | sell_all (exit everything, then stop). Case, '-' and spaces
# are forgiven (sell-all); any other word means stop. A DATA_DIR/KILL file containing the same
# words also works. [text; one of: off | stop | sell_all]
KILL_SWITCH=off
# Live: simulate the signed transaction via RPC before sending [bool]
SIMULATE_BEFORE_SEND=true
# Reject executing a quote older than this [seconds]
QUOTE_MAX_AGE_S=15
# Clears a drawdown halt once: set it to any NEW value (e.g. today's date) and redeploy. Same as
# `nightcrawler reset-halt`, but works from the Railway variables page on a phone [text]
RESET_HALT_TOKEN=
# The date (YYYY-MM-DD, e.g. 2026-10-09) you replaced every key that was ever pasted into a chat.
# Only shown on the dashboard's 'ready for real money?' checklist; leave empty until the keys really
# are replaced. Never put a key here [text]
KEYS_ROTATED_ON=

# ===== Bankroll & risk (fractions: 0.20 = 20%; *_USD in dollars; SOL amounts in SOL) ===

# Paper bankroll at first start (converted to SOL at the live price) [usd]
PAPER_START_USD=100
# Position size as a FRACTION of equity (0.20 = 20%) [fraction]
POSITION_PCT=0.2
# Largest single position [usd]
MAX_POSITION_USD=25
# Smallest position worth fees; below this, skip [usd]
MIN_POSITION_USD=5
# Max simultaneous open positions [count]
MAX_OPEN_POSITIONS=3
# Stop opening positions for the UTC day after this FRACTION loss vs start-of-day equity
# [fraction]
DAILY_LOSS_LIMIT_PCT=0.2
# Halt entries (until manual reset) after this FRACTION drawdown from the equity peak [fraction]
MAX_DRAWDOWN_HALT_PCT=0.5
# Live: refuse NEW entries while the wallet is worth more than this (protects against funding the
# wrong wallet) [usd]
MAX_WALLET_USD=150
# SOL never spent (fees, rent) [sol]
SOL_RESERVE=0.02
# Reject quotes with more PERCENT price impact (3.0 = 3%) [percent]
MAX_PRICE_IMPACT_PCT=3
# Buys: reject quotes whose signed minimum output (Ultra's slippage tolerance) is more than
# this PERCENT below the quoted output. Forced exits are never blocked by it [percent]
MAX_SLIPPAGE_PCT=3
# Paper model of network fee per swap (base + priority) [sol]
NETWORK_FEE_SOL=0.0003
# Paper model of execution slippage: every paper fill receives this many basis points LESS
# than the quote's out_amount (live fills land below the quote by Ultra's slippage, latency
# and MEV; 0 = fill exactly at the quote) [bps]
PAPER_SLIPPAGE_BPS=100

# ===== Gap-risk budgets (fractions; every open ticket counts 0.95 of itself, a rug's real loss) ===

# Worst-case daily budget as a FRACTION of start-of-day equity: today's loss plus 0.95 of every
# open ticket plus 0.95 of the new one must stay within it, or the new ticket is made smaller
# (below MIN_POSITION_USD: no buy). A stop-loss does not bound a rug [fraction]
DAILY_RISK_BUDGET_PCT=0.15
# Most of the equity (a FRACTION) that may be at rug risk in all open positions together, 0.95
# of each ticket, the new one included (alongside MAX_OPEN_POSITIONS) [fraction]
MAX_AT_RISK_PCT=0.25

# ===== Strategy: dip-rebound (fractions: 0.55 = 55%) =========================

# Ignore tokens younger than this [minutes]
MIN_AGE_MIN=60
# Ignore tokens older than this [hours]
MAX_AGE_H=48
# Market-cap window lower bound [usd]
MIN_MCAP_USD=100000
# Market-cap window upper bound [usd]
MAX_MCAP_USD=5000000
# Liquidity floor (where known) [usd]
MIN_LIQUIDITY_USD=30000
# Jupiter organicScore floor 0-100 (0 disables) [score]
MIN_ORGANIC_SCORE=0.0
# Required drawdown from the rolling high (0.55 = 55%) [fraction]
DIP_PCT=0.55
# Rolling-high window for the dip [hours]
DIP_LOOKBACK_H=6
# Consecutive closed green 1m candles to confirm buyers returned [count]
CONFIRM_GREEN=2
# Min 5m buys/sells when a snapshot is available [ratio]
MIN_BUY_SELL_RATIO=1.2
# Partial take-profit trigger above entry (0.40 = +40%) [fraction]
TAKE_PROFIT_PCT=0.4
# Share of the position sold at the take-profit [fraction]
PARTIAL_TP_FRACTION=0.5
# Trailing stop from peak after the partial (0.15 = 15%) [fraction]
TRAIL_PCT=0.15
# Stop loss below entry (0.18 = -18%) [fraction]
STOP_LOSS_PCT=0.18
# Time stop [minutes]
MAX_HOLD_MIN=120
# No re-entry into the same mint for this long after an exit [minutes]
COOLDOWN_MIN=30
# Minimum 1m candles the engine fetches per watch evaluation (it always fetches at least
# DIP_LOOKBACK_H, the window the strategy and the backtester use) [minutes]
CANDLE_WINDOW_MIN=180

# ===== Tested universe =======================================================
# The bot trades only what every test covered: pump.fun graduates quoted in SOL, never
# Mayhem-mode coins (fixed in code). Age counts from graduation as well as from creation.

# Only enter a coin this long after it GRADUATED from its bonding curve (Jupiter graduatedAt,
# GeckoTerminal as fallback); MIN_AGE_MIN still counts from creation. The lab saw the first 30
# min after graduation lose most (no entries there) [minutes]
MIN_AGE_SINCE_GRAD_MIN=30

# ===== Watchlist =============================================================

# Max tokens watched at once [count]
WATCHLIST_MAX=15
# Drop a watched token after this long [hours]
WATCHLIST_TTL_H=6

# ===== Cocoon rug filter (PERCENT: 30 = 30%) =================================

# Hard fail if top-10 holders (AMM/curve/locker excluded) own more than this PERCENT [percent]
COCOON_TOP10_MAX_PCT=30
# Hard fail if one non-AMM holder owns more [percent]
COCOON_SINGLE_HOLDER_MAX_PCT=10
# Hard fail if the creator still holds more [percent]
COCOON_CREATOR_MAX_PCT=5
# Hard fail if insider networks hold more (together with COCOON_GRAPH_INSIDERS_MIN) [percent]
COCOON_INSIDER_MAX_PCT=15
# RugCheck graphInsidersDetected at/above which insider share is enforced [count]
COCOON_GRAPH_INSIDERS_MIN=5
# Hard fail if the creator launched more tokens (serial launcher) [count]
COCOON_DEV_MINTS_MAX=20
# Graduated AMM pools: min LP locked/burned PERCENT [percent]
COCOON_LP_LOCKED_MIN_PCT=90
# Warn (not fail) below this holder count [count]
COCOON_MIN_HOLDERS=100
# Reuse a SafetyReport for this long [minutes]
COCOON_CACHE_MIN=30
# Warn (not fail) when another coin with the same normalized ticker was seen within this many
# hours (0 disables) [hours]
COCOON_COPYCAT_WINDOW_H=6
# Comma-separated brands/celebrities: warn (not fail) when a coin's name or ticker imitates one
# (look-alike letters and spacing tricks included). 'none' disables. Blank = the built-in list
# (Elon Musk, Trump, Tesla, Coinbase, Solana, Jupiter, ...) [text]
COCOON_IMPERSONATION_NAMES=

# ===== Radar: big sells by creator / top holders / insiders ==================

# Only trades at least this big are scanned [usd]
RADAR_MIN_TRADE_USD=300
# Look-back window for big sells [minutes]
RADAR_WINDOW_MIN=15
# Flag when creator/top-holder/insider sells reach this [usd]
RADAR_INSIDER_SELL_USD=500
# Flag when big sells in the window reach this PERCENT of pool liquidity [percent]
RADAR_BIG_SELL_LIQ_PCT=10
# Radar re-scan interval for open positions [seconds]
RADAR_INTERVAL_S=180

# ===== Jev, the AI judge (Anthropic API) =====================================

# Enables the AI judge [secret; SECRET]
ANTHROPIC_API_KEY=
# off | advisory | required (default: required when ANTHROPIC_API_KEY is set, else off) [text; one
# of: off | advisory | required]
JUDGE_MODE=
# Anthropic model id for the judge [text]
JUDGE_MODEL=claude-opus-5-5
# output_config.effort [text; one of: low | medium | high | xhigh | max]
JUDGE_EFFORT=low
# Per-request timeout (no retries: the engine re-asks next tick) [seconds]
JUDGE_TIMEOUT_S=10
# Reuse a verdict per mint for this long [minutes]
JUDGE_CACHE_MIN=20
# Judge spend cap per UTC day; beyond it verdicts are 'no' (source=error). 0 blocks every judge call
# (and so every entry when JUDGE_MODE=required) [usd]
JUDGE_MAX_DAILY_USD=1

# ===== Endpoints & keys ======================================================

# Optional Jupiter key (header x-api-key) [secret; SECRET]
JUPITER_API_KEY=
# Default: https://api.jup.ag with a key, else https://lite-api.jup.ag [url]
JUPITER_BASE_URL=
# Solana JSON-RPC endpoint (a free Helius key is recommended) [url]
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# The bot wallet: base58 64-byte secret (Phantom export) or JSON byte array (solana-keygen).
# Required for live; in paper mode only its address is used (quotes and the dashboard's balance
# check) [secret; SECRET]
BOT_WALLET_SECRET=
# Optional X/Twitter token (unused by default) [secret; SECRET]
X_BEARER_TOKEN=

# ===== Data sources ==========================================================

# Also discover tokens from GeckoTerminal new_pools (lowest priority feed, paused for 5 min after
# a 429). Off by default: Jupiter recent/trending plus DexScreener cover discovery and
# GeckoTerminal's small free budget is kept for candles and the radar [bool]
DISCOVER_GT_NEW_POOLS=false
# pump.fun coins: take 1m candles from pump.fun's swap API when GeckoTerminal fails, rate-limits or
# lags (one source per series, never mixed) [bool]
PUMPFUN_CANDLES=true

# ===== Learning ==============================================================

# Self-learning loop: record every pump.fun graduate and test strategy versions in the shadow. It
# never trades, never changes risk settings and uses its own small API budget; false = no learning
# calls at all [bool]
LEARN_ENABLED=true
# Disk cap for DATA_DIR/learn (oldest sealed days are deleted first; the ledger always has
# priority) [gb]
LEARN_DISK_CAP_GB=3.0
# How often the bot starts the learner in the background (replays finished days, scores every
# strategy version) [minutes]
LEARN_INTERVAL_MIN=30

# ===== Dashboard =============================================================

# Dashboard port (Railway sets PORT) [port]
PORT=8080
# Dashboard bind address [text]
DASHBOARD_HOST=0.0.0.0
# If set, the dashboard requires ?token= or cookie. Live mode needs a strong one: a long random
# password of at least 24 characters [secret; SECRET]
DASHBOARD_TOKEN=

# ===== Provider usage budgets (dashboard Usage panel; warns at 80%) ==========

# Helius credits per UTC month (free plan: 1,000,000); nightcrawler counts 1 credit per RPC call. 0
# = no budget [count]
USAGE_HELIUS_MONTHLY_CREDITS=1000000
# Jupiter calls per UTC month (0 = no budget: the free API is only rate-limited) [count]
USAGE_JUPITER_MONTHLY_CALLS=0
# GeckoTerminal calls per UTC month (0 = no budget) [count]
USAGE_GECKOTERMINAL_MONTHLY_CALLS=0
# DexScreener calls per UTC month (0 = no budget) [count]
USAGE_DEXSCREENER_MONTHLY_CALLS=0
# RugCheck calls per UTC month (0 = no budget) [count]
USAGE_RUGCHECK_MONTHLY_CALLS=0

# ===== Loop intervals (seconds) ==============================================

# Crawler poll interval [seconds]
DISCOVERY_INTERVAL_S=30
# Watchlist evaluation interval [seconds]
WATCH_INTERVAL_S=60
# Open-position marking interval [seconds]
POSITION_INTERVAL_S=10
# Equity snapshot interval [seconds]
EQUITY_INTERVAL_S=60
