# TikTok Shop UGC Generator Configuration

# OpenAI API Key (for GPT-4 script generation)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (alternative for Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ElevenLabs API Key (for realistic voiceovers)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# TikTok API Credentials (optional - for direct API access)
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret

# Stability AI (for image generation)
STABILITY_API_KEY=your_stability_api_key

# Output settings
OUTPUT_DIR=./output
VIDEO_QUALITY=high
DEFAULT_VOICE=en-US-ChristopherNeural

# Scraping settings
SCRAPE_DELAY=2
MAX_PRODUCTS_PER_SEARCH=50
