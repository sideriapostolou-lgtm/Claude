# Vercel Postgres — auto-populated when you link a Postgres database in Vercel
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# Resend — verified on omega-industries.com (Sideri confirmed 3/19)
RESEND_API_KEY=
RESEND_FROM_EMAIL=transparency@omega-industries.com

# iron-session cookie secret — 32+ random bytes (e.g. `openssl rand -hex 32`)
SESSION_SECRET=

# Magic-link + email absolute URLs point at this (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret protecting /api/cron/* endpoints (Vercel Cron sends it as Bearer)
CRON_SECRET=
